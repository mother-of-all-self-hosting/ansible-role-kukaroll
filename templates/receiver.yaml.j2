# Managed by Ansible (the kukaroll role).
# Paths as mounted into the receiver's container.
schema_version: 1
listen: 0.0.0.0:8080
spool_dir: /spool
projects:
{% for name, project in kukaroll_projects.items() %}
  {{ name | to_json }}:
    branch: {{ project.branch | to_json }}
    webhook:
      provider: {{ project.webhook_provider | to_json }}
      secret_file: /secrets/{{ name }}
{% endfor %}
