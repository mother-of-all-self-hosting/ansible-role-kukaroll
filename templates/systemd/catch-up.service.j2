# Part of the deploys target: every time deploys resume (after a playbook run, at boot), and on its timer (if enabled), every project's pending deploy gets another chance.
# A project whose branch tip is already deployed only gets a no-op run.
[Unit]
Description=kukaroll deploys catch-up ({{ kukaroll_identifier }})
PartOf={{ kukaroll_identifier }}-deploys.target
After={{ kukaroll_identifier }}-deploys.target

[Service]
Type=oneshot
ExecStart={{ kukaroll_bin_path }}/trigger --all

[Install]
WantedBy={{ kukaroll_identifier }}-deploys.target
